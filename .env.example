# Required. This is the only password that can open the whole site.
# Pick something only you know. Never commit the real value.
ADMIN_PASSWORD=

# Optional extra signing secret for studio cookies.
# If omitted, one is derived from ADMIN_PASSWORD.
SESSION_SECRET=

# Optional. If set, the studio uses this instead of a key pasted in settings.
# Also supports ANTHROPIC_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
